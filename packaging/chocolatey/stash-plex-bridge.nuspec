    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/Tgbjr2025/stash-plex-bridge</projectSourceUrl>
    <docsUrl>https://github.com/Tgbjr2025/stash-plex-bridge#readme</docsUrl>
    <bugTrackerUrl>https://github.com/Tgbjr2025/stash-plex-bridge/issues</bugTrackerUrl>
    <tags>stash plex media-server sync installer powershell</tags>
    <summary>One-command Windows installer for three Stash↔Plex bridge plugins.</summary>
    <description>
Wires three Stash↔Plex synchronisation plugins (Stash2Plex, PlexSync, StashPlexAgent.bundle) into one idempotent PowerShell installer. Detects Stash and Plex installs, extracts tokens, renders per-plugin configs, and validates the end-to-end pipeline. Safe to rerun.
    </description>
    <releaseNotes>https://github.com/Tgbjr2025/stash-plex-bridge/releases/tag/v1.0.0</releaseNotes>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
