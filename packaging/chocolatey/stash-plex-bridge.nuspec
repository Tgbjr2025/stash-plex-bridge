<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>stash-plex-bridge</id>
    <version>1.0.0</version>
    <packageSourceUrl>https://github.com/Tgbjr2025/stash-plex-bridge</packageSourceUrl>
    <owners>Tgbjr2025</owners>
    <title>Stash-Plex Bridge</title>
    <authors>Thomas Bateman / DOMINUS AXIS</authors>
    <projectUrl>https://github.com/Tgbjr2025/stash-plex-bridge</projectUrl>
    <iconUrl>https://github.com/Tgbjr2025.png</iconUrl>
    <copyright>2026 Thomas Bateman / DOMINUS AXIS</copyright>
